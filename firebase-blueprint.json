{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account document",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account document creation timestamp"
        }
      },
      "required": ["createdAt", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Primary user document"
    }
  }
}
