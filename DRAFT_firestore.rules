rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-all root
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isOwner(userId) && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'anonymous');
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.email is string &&
             data.email.size() <= 254 &&
             (!('themeMode' in data) || data.themeMode in ['system', 'light', 'dark']) &&
             (!('listDensity' in data) || data.listDensity in ['comfortable', 'compact']) &&
             (!('outdatedAfterDays' in data) || (data.outdatedAfterDays is number && data.outdatedAfterDays >= 1 && data.outdatedAfterDays <= 365)) &&
             (!('unsubscribeCount' in data) || (data.unsubscribeCount is number && data.unsubscribeCount >= 0)) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidCategory(data) {
      return data.id is string &&
             isValidId(data.id) &&
             data.id.size() <= 64 &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 48 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 256)) &&
             data.color is string &&
             data.color.matches('^#[a-fA-F0-9]{6}$') &&
             (!('orderIndex' in data) || data.orderIndex is number) &&
             data.userId is string &&
             data.userId == request.auth.uid &&
             data.updatedAt is timestamp;
    }

    function isValidPriorityRule(data) {
      return data.id is string &&
             isValidId(data.id) &&
             data.id.size() <= 64 &&
             data.type in ['sender', 'category'] &&
             data.target is string &&
             data.target.size() > 0 &&
             data.target.size() <= 254 &&
             data.priority in ['High', 'Normal', 'Low'] &&
             data.userId is string &&
             data.userId == request.auth.uid &&
             data.updatedAt is timestamp;
    }

    function isValidInboxState(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.updatedAt is timestamp &&
             (!('protectedSenders' in data) || (data.protectedSenders is list && data.protectedSenders.size() <= 500)) &&
             (!('blockedSenders' in data) || (data.blockedSenders is list && data.blockedSenders.size() <= 500));
    }

    function isValidCleanupRecord(data) {
      return data.id is string &&
             isValidId(data.id) &&
             data.id.size() <= 64 &&
             data.userId is string &&
             data.userId == request.auth.uid &&
             data.groupTitle is string &&
             data.groupTitle.size() <= 128 &&
             data.action in ['trash', 'archive'] &&
             data.date is timestamp &&
             (data.emailIds is list && data.emailIds.size() <= 500);
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isVerifiedOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().keys().hasAll(['userId', 'email', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'themeMode', 'listDensity', 'outdatedAfterDays', 'unsubscribeCount', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;
      allow update: if isVerifiedOwner(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['themeMode', 'listDensity', 'outdatedAfterDays', 'unsubscribeCount', 'updatedAt', 'email']);
      allow delete: if false;

      // User Categories
      match /categories/{categoryId} {
        allow get: if isOwner(userId) && isValidId(categoryId);
        allow list: if isOwner(userId);
        allow create: if isVerifiedOwner(userId) &&
                         isValidId(categoryId) &&
                         isValidCategory(incoming()) &&
                         incoming().id == categoryId &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['id', 'name', 'color', 'userId', 'updatedAt']) &&
                         incoming().keys().hasOnly(['id', 'name', 'description', 'color', 'orderIndex', 'userId', 'updatedAt']) &&
                         incoming().updatedAt == request.time;
        allow update: if isVerifiedOwner(userId) &&
                         isValidId(categoryId) &&
                         isValidCategory(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'color', 'orderIndex', 'updatedAt']);
        allow delete: if isVerifiedOwner(userId) && isValidId(categoryId);
      }

      // Priority Rules
      match /priorityRules/{ruleId} {
        allow get: if isOwner(userId) && isValidId(ruleId);
        allow list: if isOwner(userId);
        allow create: if isVerifiedOwner(userId) &&
                         isValidId(ruleId) &&
                         isValidPriorityRule(incoming()) &&
                         incoming().id == ruleId &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['id', 'type', 'target', 'priority', 'userId', 'updatedAt']) &&
                         incoming().keys().hasOnly(['id', 'type', 'target', 'priority', 'userId', 'updatedAt']) &&
                         incoming().updatedAt == request.time;
        allow update: if isVerifiedOwner(userId) &&
                         isValidId(ruleId) &&
                         isValidPriorityRule(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['type', 'target', 'priority', 'updatedAt']);
        allow delete: if isVerifiedOwner(userId) && isValidId(ruleId);
      }

      // Inbox State (overrides, protected senders)
      match /state/inboxState {
        allow get: if isOwner(userId);
        allow create: if isVerifiedOwner(userId) &&
                         isValidInboxState(incoming()) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'readOverrides', 'trashArchiveOverrides', 'protectedSenders', 'blockedSenders', 'senderOverrides', 'assignments', 'updatedAt']) &&
                         incoming().updatedAt == request.time;
        allow update: if isVerifiedOwner(userId) &&
                         isValidInboxState(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['readOverrides', 'trashArchiveOverrides', 'protectedSenders', 'blockedSenders', 'senderOverrides', 'assignments', 'updatedAt']);
        allow delete: if false;
      }

      // Cleanup History
      match /cleanupHistory/{historyId} {
        allow get: if isOwner(userId) && isValidId(historyId);
        allow list: if isOwner(userId);
        allow create: if isVerifiedOwner(userId) &&
                         isValidId(historyId) &&
                         isValidCleanupRecord(incoming()) &&
                         incoming().id == historyId &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['id', 'userId', 'groupTitle', 'action', 'emailIds', 'date']) &&
                         incoming().keys().hasOnly(['id', 'userId', 'groupTitle', 'action', 'emailIds', 'date']) &&
                         incoming().date == request.time;
        allow update: if false;
        allow delete: if isVerifiedOwner(userId) && isValidId(historyId);
      }
    }
  }
}
